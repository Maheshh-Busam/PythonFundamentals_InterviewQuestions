SQLAlchemy
-----------

# Assume session is an active SQLAlchemy Session.
# Assume Employee is a valid mapped model.

employee = Employee(name="Ravi", salary=50000)

session.add(employee)

print(employee.id)

session.flush()

print(employee.id)

# Why might the first ID be None?
# Why might the ID be available after flush()?
# Has the transaction necessarily been committed?

-----------------------------------------------------

# Assume session is an active SQLAlchemy Session.

try:
    employee = Employee(name="Ravi", salary=-100)
    session.add(employee)
    session.commit()
except Exception:
    session.rollback()
    print("Transaction failed")

# Under what circumstances does the except block execute?
# Why is rollback() important?

