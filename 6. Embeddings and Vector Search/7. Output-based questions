Metadata and retrieval
---------------------------

documents = [
    {"id": 1, "category": "AI", "content": "Introduction to LLMs"},
    {"id": 2, "category": "Java", "content": "Spring Boot basics"},
    {"id": 3, "category": "AI", "content": "Introduction to RAG"}
]

results = [
    doc for doc in documents
    if doc["category"] == "AI"
]

print(len(results))
print(results[0]["content"])

