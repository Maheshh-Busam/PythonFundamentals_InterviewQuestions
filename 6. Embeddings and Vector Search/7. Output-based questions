chunks = [
    {"document_id": 1, "chunk_id": 2, "content": "Second chunk"},
    {"document_id": 1, "chunk_id": 1, "content": "First chunk"},
    {"document_id": 1, "chunk_id": 3, "content": "Third chunk"}
]

chunks.sort(key=lambda x: x["chunk_id"])

for chunk in chunks:
    print(chunk["content"])

