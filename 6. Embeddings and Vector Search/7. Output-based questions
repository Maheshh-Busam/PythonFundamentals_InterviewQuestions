Chunking
-------

text = "Python is easy to learn and useful for AI applications."

chunk_size = 10

chunks = [
    text[i:i + chunk_size]
    for i in range(0, len(text), chunk_size)
]

print(chunks)

-----------------

text = "ABCDEFGHIJ"

chunk_size = 4
overlap = 2

chunks = []

for i in range(0, len(text), chunk_size - overlap):
    chunks.append(text[i:i + chunk_size])

print(chunks)

------------------

chunks = [
    {"chunk_id": 1, "content": "Introduction"},
    {"chunk_id": 2, "content": "Installation"},
    {"chunk_id": 3, "content": "Configuration"}
]

for chunk in chunks:
    print(chunk["chunk_id"], chunk["content"])

