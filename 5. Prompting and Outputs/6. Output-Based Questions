chunks = [
    {"content": "Hello"},
    {"content": " World"},
    {"content": ""},
    {"finish_reason": "stop"}
]

for chunk in chunks:
    if "content" in chunk:
        print(chunk["content"], end="")

    if chunk.get("finish_reason") == "stop":
        print("\nStream completed")

